DATABASE_URL="file:../data/dev.db"
SESSION_SECRET="replace-with-secure-random-32-char-string"
# Set to "true" only if the app is served over HTTPS (e.g. behind a reverse proxy/tunnel).
# Leaving this "true" while serving over plain HTTP makes the browser silently drop the
# session cookie, so every login appears to succeed but immediately bounces back to /login.
COOKIE_SECURE="false"
